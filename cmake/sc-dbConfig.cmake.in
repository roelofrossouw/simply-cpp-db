@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# sc-db links PostgreSQL publicly, so a consumer needs that imported target as well.
# On macOS find_package cannot see a brew keg without being pointed at it - the same
# hint the project uses when it builds, applied here so consumers do not need to know.
if (APPLE AND NOT PostgreSQL_ROOT)
    execute_process(COMMAND pg_config --libdir
            OUTPUT_VARIABLE PostgreSQL_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    # --libdir is the keg's lib/, not its root; find_package expects the root itself.
    if (PostgreSQL_ROOT)
        get_filename_component(PostgreSQL_ROOT "${PostgreSQL_ROOT}" DIRECTORY)
    endif ()
endif ()
find_dependency(PostgreSQL)

include ("${CMAKE_CURRENT_LIST_DIR}/sc-dbTargets.cmake")
